        "#usamos o return para retornar valores de uma func e encerrar sua execucao\n",
        "# funcao para calcular percentual de um valor qualquer\n",
        "# e possivel deixar um valor fixo para um argumento, quando ele nao e informado\n",
        "# na chamada o valor padrao e utilizado\n",
        "def calcula_percento(valor,percentual=100):\n",
        "  quanto = valor * percentual / 100\n",
        "  return quanto\n",
        "print ('20% de 300 são: {:10.2f}' .format (calcula_percento (300,20)))\n",
        "print ('100% de 50 são: {:10.2f}' .format (calcula_percento (50)))"
