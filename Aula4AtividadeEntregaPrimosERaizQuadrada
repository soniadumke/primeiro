        "#trabalho de entrega\n",
        "#parte 1 primos\n",
        "\n",
        "numero = int(input(\"Digite um número: \"))\n",
        "\n",
        "if numero == 0 or numero == 1:\n",
        "    print(\"O número não é primo.\")\n",
        "\n",
        "elif numero == 2:\n",
        "    print(\"O número é primo.\")\n",
        "\n",
        "elif numero % 2 == 0:\n",
        "    print(\"O número não é primo.\")\n",
        "\n",
        "else:\n",
        "    primo = True\n",
        "\n",
        "    divisor = 3\n",
        "\n",
        "    while divisor <= numero:\n",
        "        if numero % divisor == 0:\n",
        "            primo = False\n",
        "            break\n",
        "\n",
        "        divisor = divisor + 2\n",
        "\n",
        "    if primo:\n",
        "        print(\"O número é primo.\")\n",
        "    else:\n",
        "        print(\"O número não é primo.\")"
      ]
    },
