        "#parte 2\n",
        "# raiz quadrada\n",
        "\n",
        "import math\n",
        "\n",
        "n = float(input(\"Digite um número: \"))\n",
        "\n",
        "b = n\n",
        "\n",
        "p = (b + (n / b)) / 2\n",
        "\n",
        "quadrado = p ** 2\n",
        "\n",
        "while abs(n - quadrado) >= 0.0001:\n",
        "    b = p\n",
        "\n",
        "    p = (b + (n / b)) / 2\n",
        "\n",
        "    quadrado = p ** 2\n",
        "\n",
        "print(\"Raiz pelo método de Newton:\", p)\n",
        "\n",
        "raiz = math.sqrt(n)\n",
        "\n",
        "print(\"Raiz usando SQRT:\", raiz)"
