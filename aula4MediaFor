        "#for para passar pela lista\n",
        "#lista de notas de prova\n",
        "notas_provas = [9, 6.5, 3.5, 8.5]\n",
        "soma = 0\n",
        "for nota in notas_provas:\n",
        "  soma = soma + nota\n",
        "média = soma / 4\n",
        "#sem saber a quantidade de notas\n",
        "#len (notas_provas)\n",
        "print('Média = ', média)"
